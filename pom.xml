<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.flowershop</groupId>
        <artifactId>flower-shop-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <!-- Parent nằm ở repo flower-shop-platform.
             Trong workspace: Maven đọc thẳng file này (sửa platform là service thấy ngay).
             Clone repo này đứng riêng (CI, máy khác): file không tồn tại -> Maven tự lấy từ ~/.m2 / GitHub Packages. -->
        <relativePath>../platform/pom.xml</relativePath>
    </parent>

    <artifactId>api-gateway</artifactId>
    <!-- Mỗi service có version riêng, release độc lập với service khác -->
    <version>0.2.0-SNAPSHOT</version>
    <name>api-gateway</name>

    <!-- Gateway chạy WebFlux (reactive), KHÔNG được kéo spring-boot-starter-web vào,
         nên không phụ thuộc common-lib -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Lớp kiểm tra JWT thứ nhất, ngay ở cửa vào (bản reactive cho WebFlux) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
